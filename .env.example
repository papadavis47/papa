# papa-relay settings. Copy to `.env` (gitignored), fill in, then load it
# into the shell before starting the relay:
#
#   set -a; source .env; set +a; cargo run -p papa-relay
#
# Values here are dummies. Never commit real ones.

# Where the API listens.
PAPA_RELAY_ADDR=127.0.0.1:8787
# The relay's own database (accounts, invites, sessions, shares). The admin
# socket is created next to it, as `<file>.admin.sock`.
PAPA_RELAY_DB=relay.db
# Sign-ups, log-ins and child sign-ins allowed per client address per minute.
PAPA_RELAY_AUTH_PER_MINUTE=10
# Behind a proxy, the header holding the client's address (Fly.io: Fly-Client-IP).
# Leave empty when clients connect directly.
PAPA_RELAY_CLIENT_IP_HEADER=
# Log levels.
RUST_LOG=papa_relay=info,tower_http=info

# `local`: share databases live on a local `tursodb --sync-server` (development).
# `cloud`: Turso Cloud, through the Platform API.
PAPA_RELAY_MODE=local

# --- local mode ---
# The sync server: `tursodb --sync-server 127.0.0.1:8080 --sync-dir dev-sync`
PAPA_RELAY_LOCAL_SYNC_URL=http://127.0.0.1:8080
# The server's --sync-dir, so revoking a share deletes its files.
PAPA_RELAY_LOCAL_SYNC_DIR=dev-sync

# --- cloud mode ---
# The organization's slug, and the group new databases go in.
TURSO_ORG=your-org
TURSO_GROUP=default
# A Platform API token for the organization (`turso auth api-tokens mint papa-relay`).
TURSO_PLATFORM_TOKEN=replace-me
# Only to point at a stand-in API.
# TURSO_API_URL=https://api.turso.tech
